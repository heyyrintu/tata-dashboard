# ================================
# NPL DEF Dashboard - Environment Variables
# Copy this file to .env and fill in your values.
#
# In production these are set in the Coolify UI as RUNTIME variables. None of
# them is a build argument: the backend reads process.env, and the frontend
# reads /env.js, which docker-entrypoint.sh writes from this same environment
# before nginx starts. Changing any value is a restart, not a rebuild.
# ================================

# ================================
# Database (remote PostgreSQL) - REQUIRED
# ================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Schema migrations run from backend/prisma/migrations via `prisma migrate
# deploy` on boot. Set to false if a separate release step owns them.
RUN_MIGRATIONS=true

# ================================
# Application URLs - REQUIRED in production
# ================================
# Origin(s) allowed to call the API from a browser. Comma-separated; the
# apex/www counterpart of each entry is allowed automatically.
FRONTEND_URL=https://dashboard.example.com

# Backend ORIGIN for the frontend. Leave EMPTY for the single-container
# deployment: nginx serves the SPA and proxies /api on the same origin, and a
# production build defaults to same-origin requests. Only set this when the API
# lives on a different host.
VITE_API_URL=

# ================================
# API authentication - REQUIRED in production
# ================================
# The server refuses to boot in production without API_KEY. Without it every
# /api route is public, including POST /api/upload, which replaces every row
# in the shipments table.
# Generate with: openssl rand -hex 32
API_KEY=

# The key the browser sends. Anything in a VITE_* variable is readable by any
# visitor, so this is NOT a secret - it only keeps casual traffic off the API.
VITE_API_KEY=

# ================================
# Reverse proxy
# ================================
# Which upstream hops to trust for X-Forwarded-For, used to key rate limits.
# The default trusts loopback + private ranges, which covers the in-container
# nginx and Coolify's proxy. Set a number for a fixed hop count, or `false` to
# disable. Leave unset unless the proxy chain is unusual.
# TRUST_PROXY=

# ================================
# Graceful shutdown
# ================================
# Milliseconds to let in-flight requests drain on SIGTERM before forcing exit.
# Must stay below supervisord's stopwaitsecs (15s).
# SHUTDOWN_TIMEOUT_MS=10000

# ================================
# Appwrite Authentication
#
# The VITE_* pair configures the browser SDK (injected at runtime via /env.js).
# The unprefixed pair lets the BACKEND verify the JWT the browser sends. Both
# are needed for user sign-in: without the backend pair no user can be
# identified, so everyone falls back to the shared key and the masked role.
# ================================
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id

# ================================
# Roles - two INDEPENDENT Appwrite teams
#
# Membership is read server-side from the verified JWT. Nothing the browser
# sends can influence either grant, which is the point: the masking exists so
# the client cannot lift it.
#
#   HO_TEAM_ID    - members see REAL carrier names. Everyone else sees
#                   pseudonyms ("Carrier 4F2"). Unset => nobody sees real names.
#   ADMIN_TEAM_ID - members may POST /api/upload, which REPLACES every shipment
#                   row. Unset => nobody can upload.
#
# Deliberately separate: an HO analyst can read carrier names without being
# trusted to wipe and reload the dataset, and an operator can run the upload
# without needing carrier identities.
# ================================
HO_TEAM_ID=
ADMIN_TEAM_ID=

# ================================
# Carrier masking kill-switch
#
#   auto (default) - mask for client, real names for HO_TEAM_ID members
#   always         - mask EVERYONE regardless of role (use if names are leaking)
#   off            - never mask (internal-only deployment, no client audience)
#
# An unrecognised value falls back to `auto`, never to `off`.
# ================================
CLIENT_VIEW=auto

# ================================
# Local development only
#
# With VITE_BYPASS_AUTH=true the frontend skips login, so there is no JWT to
# send. These force a role instead. BOTH are ignored when NODE_ENV=production.
#   DEV_ROLE  - "ho" or "client"
#   DEV_ADMIN - "true"/"false"; defaults to following DEV_ROLE=ho. Set it
#               explicitly to exercise the HO-without-upload split.
# ================================
# DEV_ROLE=ho
# DEV_ADMIN=false

# ================================
# Logo URL (Optional)
# ================================
VITE_LOGO_URL=

# ================================
# IMAP Email Ingestion (Optional, off by default)
# ================================
ENABLE_EMAIL_POLLING=false
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_ALLOWED_SENDER=
IMAP_ARCHIVE_FOLDER=Processed
EMAIL_POLL_INTERVAL=600000

# ================================
# Local development only (docker-compose.dev.yml)
#
# The dev stack hardcodes postgres/postgres for its throwaway container, so
# these are only needed if you point it somewhere else. Left empty on purpose:
# a template that ships a concrete password is both a secret-scanner finding
# and a bad pattern to copy.
# ================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=npl_dashboard
